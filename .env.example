APP_NAME="OSSI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Run `herd secure ossi_official_site` once: the camera and GPS only work on HTTPS.
APP_URL=https://ossi_official_site.test
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ossi_official_site
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Idle sign-out (the security control). SESSION_LIFETIME above is only storage cleanup.
SESSION_IDLE_TIMEOUT_ENABLED=true
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_IDLE_WARNING_SECONDS=60

# Privacy notice (RA 10173). Bump the version after editing config/privacy.php.
PRIVACY_NOTICE_VERSION=2026-10-24.1
PRIVACY_OFFICER_NAME="Data Protection Officer"
PRIVACY_OFFICER_EMAIL=
PRIVACY_OFFICER_PHONE=
PRIVACY_CONTROLLER_NAME="${APP_NAME}"
PRIVACY_CONTROLLER_ADDRESS="Registered office address"

# Live notifications (the bell updates without a page reload). Locally `composer dev` starts
# Reverb on port 8080; make up any key/secret. On Laravel Cloud, attach a WebSockets cluster
# and it fills in the REVERB_* values. With BROADCAST_CONNECTION=log the bell still works,
# just on page loads.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ossi
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Private disk for punch selfies and avatars. Use an S3-compatible bucket in production.
ATTENDANCE_PHOTO_DISK=local
LOAD_PROOFS_DISK=
# Leave documents and complaint proof: private too. Empty = ATTENDANCE_PHOTO_DISK.
LEAVE_DOCUMENTS_DISK=
COMPLAINT_FILES_DISK=
# 201 file scans. Leave empty to use the same private disk as the photos.
HR_DOCUMENTS_DISK=
# Admin's documents, licenses and signed policies. Leave empty to use the 201 disk.
COMPANY_DOCUMENTS_DISK=
# GCash receipts and QR for load purchases. Leave empty to use the photo disk.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP: MAIL_PASSWORD is a Google App Password, never your account password.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Must not be blank: a blank address skips Laravel's fallback and every email fails. Use the Gmail account in production.
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sent in the User-Agent to OpenStreetMap's Nominatim, as its usage policy asks.
NOMINATIM_CONTACT_EMAIL=
ATTENDANCE_REVERSE_GEOCODE_THROTTLE=20

# A guard on the roster with no clock-in and no notice when their grace period ends is a
# no-show: Operations is alerted at once. Still uncovered this many minutes later, Operation HQ again.
ATTENDANCE_NO_SHOW_ESCALATE_MINUTES=30

# The head office: office staff's time out (Office Away) is measured from here.
OFFICE_NAME="OSSI Head Office"
OFFICE_LATITUDE=
OFFICE_LONGITUDE=

VITE_APP_NAME="${APP_NAME}"

# Payroll adjustments apply at once. Set an amount (e.g. 5000) to make larger ones wait for a Super Admin.
PAYROLL_ADJUSTMENT_APPROVAL_THRESHOLD=
